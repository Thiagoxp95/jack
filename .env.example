# Convex deployment configuration.
# These values are generated automatically when you run `npx convex dev`
# (they are written to .env.local, which is gitignored).
# Copy this file to .env.local and fill in the values for your own deployment.

# Your Convex deployment identifier, e.g. dev:your-deployment-123
CONVEX_DEPLOYMENT=

# Your Convex cloud URL, e.g. https://your-deployment-123.convex.cloud
CONVEX_URL=

# Your Convex HTTP actions site URL, e.g. https://your-deployment-123.convex.site
CONVEX_SITE_URL=
